---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo/logo.png';
import { client } from '../data/client';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { label: 'Domů',     href: '/' },
  { label: 'O mně',    href: '/#o-mne' },
  { label: 'Služby',   href: '/sluzby' },
  { label: 'Recenze',  href: '/recenze' },
  { label: 'Kontakt',  href: '/kontakt' },
];

const currentPath = Astro.url.pathname;

function isNavActive(href: string) {
  const path = href.split('#')[0] || '/';
  if (href.includes('#')) return false;
  return currentPath === path || (path !== '/' && currentPath.startsWith(path));
}
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-3 sm:px-6">
    <!-- Logo -->
    <a
      href="/"
      class="inline-flex shrink-0 items-center transition-opacity hover:opacity-80"
      aria-label="Taclík Elektro - domů"
    >
      <Image
        src={logo}
        alt="Taclík Elektro"
        class="brand-logo h-10 w-auto max-w-[150px] object-contain sm:h-12 sm:max-w-[180px] lg:h-11"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Hlavní navigace">
      {nav.map(({ label, href }) => {
        const isActive = isNavActive(href);
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class="rounded-md px-3 py-2 text-sm font-medium text-text transition-colors hover:bg-surface aria-[current=page]:bg-primary/10"
          >
            {label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA + phone -->
    <div class="hidden items-center gap-3 lg:flex">
      {client.license && (
        <span class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-muted">
          {client.license}
        </span>
      )}
      <ThemeToggle />
      <a
        href={`tel:${client.phoneForTel}`}
        class="text-sm font-semibold text-text hover:text-primary transition-colors"
      >
        {client.phoneFormatted}
      </a>
      <a
        href="/kontakt"
        class="button-accent inline-flex min-h-[44px] items-center rounded-md px-5 py-2.5 text-sm font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Nezávazná nabídka
      </a>
    </div>

    <div class="flex items-center gap-1 lg:hidden">
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-text-muted hover:bg-surface lg:hidden"
      >
        <span class="sr-only">Přepnout menu</span>
        <svg id="menu-icon-open" class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background px-4 pb-6 pt-2 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobilní navigace">
      {nav.map(({ label, href }) => {
        const isActive = isNavActive(href);
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class="rounded-md px-3 py-3 text-base font-medium text-text transition-colors hover:bg-surface aria-[current=page]:bg-primary/10"
          >
            {label}
          </a>
        );
      })}
    </nav>

    <div class="mt-4 flex flex-col gap-3 border-t border-border pt-4">
      <a
        href={`tel:${client.phoneForTel}`}
        class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text"
      >
        <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {client.phoneFormatted}
      </a>
      <a
        href="/kontakt"
        class="button-accent flex min-h-[44px] items-center justify-center rounded-md px-5 py-3 text-base font-bold"
      >
        Nezávazná nabídka zdarma
      </a>
      {client.license && (
        <p class="px-3 pt-1 text-xs text-text-muted">{client.license}</p>
      )}
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.querySelector('header');
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!header || !btn || !menu || !iconOpen || !iconClose) return;
    if (btn.dataset.menuInit === 'true') return;
    btn.dataset.menuInit = 'true';

    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    const setMenuOpen = (nextOpen: boolean) => {
      if (isDesktop()) nextOpen = false;
      btn.setAttribute('aria-expanded', String(nextOpen));
      menu.classList.toggle('hidden', !nextOpen);
      iconOpen.classList.toggle('hidden', nextOpen);
      iconClose.classList.toggle('hidden', !nextOpen);
    };

    btn.addEventListener('click', () => {
      if (isDesktop()) return;
      setMenuOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    menu.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('a[href]')) setMenuOpen(false);
    });

    window.addEventListener('resize', () => setMenuOpen(false));
    setMenuOpen(false);
  }

  document.addEventListener('astro:before-preparation', () => {
    const menu = document.getElementById('mobile-menu');
    const btn = document.getElementById('menu-toggle');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    if (!menu || !btn || !iconOpen || !iconClose) return;
    btn.setAttribute('aria-expanded', 'false');
    menu.classList.add('hidden');
    iconOpen.classList.remove('hidden');
    iconClose.classList.add('hidden');
  });

  document.addEventListener('astro:page-load', initHeader);
</script>
