---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { client } from '../data/client';
import { heroImage as localHeroImage, heroImageIsLogo } from '../config/images';

// Fallback Unsplash URL used until a local image is added to
// src/assets/images/hero/ and registered in src/config/images.ts
const PLACEHOLDER = 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200&q=80';

interface Props {
  heading?: string;
  animateWords?: boolean;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  heading = brand.tagline,
  animateWords = true,
  description = brand.description,
  ctaLabel = 'Poptat moji práci',
  ctaHref = '/kontakt',
  secondaryLabel = 'Mé služby',
  secondaryHref = '/sluzby',
  imageSrc = localHeroImage ?? PLACEHOLDER,
  imageAlt = heroImageIsLogo ? brand.name : 'Elektrikář při elektroinstalační práci',
} = Astro.props;

const localImage = typeof imageSrc === 'string' ? undefined : imageSrc;
const heroSrc = localImage ? localImage.src : imageSrc;
const heroWidth = localImage ? localImage.width : 1600;
const heroHeight = localImage ? localImage.height : 1200;
const imageClass = heroImageIsLogo
  ? 'brand-logo size-full object-contain p-8 sm:p-10'
  : 'size-full object-cover object-top';
---

<section class="relative overflow-hidden bg-background py-12 sm:py-16 md:py-20 lg:py-24">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12">

    <!-- Copy -->
    <div class="order-2 space-y-5 lg:order-1 lg:space-y-6">
      <h1
        class="hero-enter-up font-heading text-display font-bold uppercase leading-[1.15] tracking-tight text-text"
        transition:name="hero-heading"
      >
        {animateWords ? (
          <>
            Spolehlivý elektrikář pro vaše{' '}
            <span class="hero-rotate-slot">
              <span data-hero-rotate-word class="hero-rotate-word text-primary-light" aria-live="polite">domácnosti</span>
            </span>
          </>
        ) : (
          heading
        )}
      </h1>

      <p class="hero-enter-up hero-enter-delay-1 max-w-lg text-lead text-text-muted leading-relaxed">
        {description}
      </p>

      <!-- CTA row -->
      <div class="hero-enter-up hero-enter-delay-2 flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:gap-4">
        <a
          href={ctaHref}
          class="button-accent inline-flex min-h-[44px] items-center justify-center rounded-md px-6 py-3 text-base font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {ctaLabel}
        </a>
        <a
          href={secondaryHref}
          class="button-outline button-lift inline-flex min-h-[44px] items-center justify-center rounded-md px-6 py-3 text-base font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {secondaryLabel}
        </a>
      </div>

      <!-- Tap-to-call -->
      <a
        href={`tel:${client.phoneForTel}`}
        class="hero-enter-up hero-enter-delay-3 inline-flex items-center gap-2 pt-1 text-sm font-semibold text-text-muted transition-colors hover:text-primary"
      >
        <svg class="size-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Zavolat {client.phoneFormatted}
      </a>
    </div>

    <!-- Hero image: logo is already in the header, so hide the large mark on small screens -->
    <div
      class:list={[
        'hero-enter-img relative overflow-visible lg:order-2',
        heroImageIsLogo ? 'hidden lg:block' : 'order-1',
      ]}
      transition:name="hero-image"
    >
      <div class:list={[heroImageIsLogo ? 'aspect-square mx-auto w-full max-w-sm sm:max-w-md lg:max-w-[26rem]' : 'aspect-4/3', '[perspective:1200px]']}>
        <div class="hero-img-float relative size-full overflow-visible">
          <div
            class="absolute -inset-2 rounded-lg bg-primary/5 blur-xl"
            aria-hidden="true"
          ></div>
          <div
            class:list={[
              'hero-img-float-shadow relative size-full overflow-hidden rounded-lg border shadow-[0_0.75rem_1.5rem_rgba(15,23,42,0.12),0_0.25rem_0.625rem_rgba(15,23,42,0.08)] [transform:translateZ(0)] [transform-style:preserve-3d]',
              heroImageIsLogo ? 'border-border bg-surface' : 'border-white/60',
            ]}
          >
            {localImage ? (
              <Image
                src={localImage}
                alt={imageAlt}
                loading="eager"
                decoding="async"
                class={imageClass}
              />
            ) : (
              <img
                src={heroSrc}
                alt={imageAlt}
                width={heroWidth}
                height={heroHeight}
                loading="eager"
                decoding="async"
                class={imageClass}
              />
            )}
            {!heroImageIsLogo && (
              <>
                <div
                  class="pointer-events-none absolute inset-0 bg-[linear-gradient(135deg,rgba(255,255,255,0.32)_0%,rgba(255,255,255,0.08)_32%,rgba(15,23,42,0.16)_100%)]"
                  aria-hidden="true"
                ></div>
                <div
                  class="pointer-events-none absolute inset-x-0 top-0 h-1/3 bg-linear-to-b from-white/25 to-transparent"
                  aria-hidden="true"
                ></div>
              </>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{animateWords && (
  <script>
    const ROTATE_INTERVAL_MS = 3000;
    const SWAP_DURATION_MS = 650;

    const words = [
      { text: 'domácnosti', colorClass: 'text-primary-light' },
      { text: 'firmy', colorClass: 'text-accent' },
    ] as const;

    let rotateTimeoutId: number | undefined;
    let rotateIntervalId: number | undefined;

    function initHeroWordRotate() {
      if (rotateTimeoutId) window.clearTimeout(rotateTimeoutId);
      if (rotateIntervalId) window.clearInterval(rotateIntervalId);

      const wordEl = document.querySelector<HTMLElement>('[data-hero-rotate-word]');
      if (!wordEl) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let index = 0;

      const rotate = () => {
        const nextIndex = (index + 1) % words.length;
        const next = words[nextIndex];

        wordEl.classList.add('is-swapping');

        window.setTimeout(() => {
          wordEl.textContent = next.text;
          wordEl.classList.remove('text-primary-light', 'text-accent');
          wordEl.classList.add(next.colorClass);
          void wordEl.offsetWidth;
          wordEl.classList.remove('is-swapping');
          index = nextIndex;
        }, SWAP_DURATION_MS);
      };

      rotateTimeoutId = window.setTimeout(() => {
        rotate();
        rotateIntervalId = window.setInterval(rotate, ROTATE_INTERVAL_MS);
      }, ROTATE_INTERVAL_MS);
    }

    initHeroWordRotate();
    document.addEventListener('astro:page-load', initHeroWordRotate);
  </script>
)}
