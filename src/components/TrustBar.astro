---
import { renderLucideIcon } from '../utils/lucide';

interface TrustItem {
  icon: string;
  label: string;
  value?: string;
}

interface Props {
  items?: TrustItem[];
  reveal?: boolean;
}

const { reveal = false, items = [
  { icon: 'ShieldCheck', label: 'Plně pojištěno' },
  { icon: 'CalendarClock', label: 'let zkušeností', value: '9' },
  { icon: 'CircleCheck', label: 'dokončených zakázek', value: '100+' },
] } = Astro.props;
---

<section class="border-y border-border bg-surface" aria-label="Důvěryhodnost">
  <div class="mx-auto max-w-site overflow-x-auto px-4 py-5 sm:px-6 sm:py-6">
    <ul class="flex flex-wrap items-center justify-between gap-6 sm:gap-8 lg:justify-center lg:gap-16" role="list">
      {items.map((item, i) => (
        <li
          class:list={[
            'flex shrink-0 items-center gap-2.5 text-sm sm:text-base',
            reveal && 'reveal',
            reveal && `reveal-delay-${(i % 4) + 1}`,
          ]}
        >
          <Fragment set:html={renderLucideIcon(item.icon, 'size-5 shrink-0 text-orange-500')} />
          <span class="font-heading font-semibold text-text">
            {item.value && <span class="text-primary">{item.value} </span>}
            {item.label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
