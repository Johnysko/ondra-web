---
import type { ImageMetadata } from 'astro';
import { aboutImage as localAboutImage } from '../config/images';

// Fallback Unsplash URL used until a local image is added to
// src/assets/images/about/ and registered in src/config/images.ts
const PLACEHOLDER = 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=900&q=80';

interface Props {
  topper?: string;
  heading?: string;
  body?: string[];
  benefits?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
  reveal?: boolean;
}

const {
  reveal = false,
  topper = 'O mně',
  heading = 'Ondřej Taclík - Váš elektrikář',
  body = [
    'Jsem certifikovaný elektrikář s několikaletou praxí v oboru. Zabývám se kompletními elektroinstalacemi – od drobných oprav v domácnostech přes celkové rekonstrukce bytů a domů až po realizace v zahraničí.',
    'Práce s elektřinou pro mě není jen obor, ale řemeslo, na kterém závisí bezpečnost a komfort vašeho domova či firmy. Zakládám si na tom, aby po mně práce zůstala odvedená čistě, bezpečně a v přesně dohodnutém termínu.',
  ],
  benefits = [
    'Certifikovaný partner Loxone',
    'Osobní přístup',
  ],
  ctaLabel = 'Nezávazná nabídka',
  ctaHref = '/kontakt',
  imageSrc = localAboutImage ?? PLACEHOLDER,
  imageAlt = 'Ondra Taclík, elektrikář',
} = Astro.props;

const aboutSrc = typeof imageSrc === 'string' ? imageSrc : imageSrc.src;
const aboutWidth = typeof imageSrc === 'string' ? 700 : imageSrc.width;
const aboutHeight = typeof imageSrc === 'string' ? 525 : imageSrc.height;
---

<section id="o-mne" class="scroll-mt-28 py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">

    <!-- Image -->
    <div class:list={['overflow-hidden rounded-lg shadow-lg', reveal && 'reveal reveal-from-left']}>
      <img
        src={aboutSrc}
        alt={imageAlt}
        width={aboutWidth}
        height={aboutHeight}
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    </div>

    <!-- Content -->
    <div class:list={['space-y-5', reveal && 'reveal reveal-delay-2']}>
      <span class="text-topper font-bold uppercase tracking-widest text-accent">{topper}</span>
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{heading}</h2>

      {body.map((paragraph) => (
        <p class="text-text-muted leading-relaxed">{paragraph}</p>
      ))}

      <!-- Benefits list -->
      <ul class="space-y-3 pt-2" role="list">
        {benefits.map((benefit) => (
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 size-5 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-text">{benefit}</span>
          </li>
        ))}
      </ul>

      <div class="pt-2">
        <a
          href={ctaHref}
          class="button-outline button-lift inline-flex min-h-[44px] items-center gap-2 rounded-md px-6 py-3 text-base font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
