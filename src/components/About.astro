---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { aboutImage as localAboutImage } from '../config/images';

// Fallback Unsplash URL used until a local image is added to
// src/assets/images/about/ and registered in src/config/images.ts
const PLACEHOLDER = 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=900&q=80';

interface Props {
  topper?: string;
  heading?: string;
  body?: string[];
  benefits?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
  reveal?: boolean;
}

const {
  reveal = false,
  topper = 'O mně',
  heading = 'Ondra Taclík — profesionální elektrikář',
  body = [
    'Jsem elektrikář pro domácnosti i firmy v Praze a okolí. Provádím silnoproudé instalace, revize, osvětlení, zabezpečení i chytré domácnosti — vždy podle platných norem a s důrazem na bezpečnost.',
    'Každou zakázku řeším osobně, srozumitelně a tak, abyste přesně věděli, co se ve vašem objektu děje.',
  ],
  benefits = [
    'Licencovaný a pojištěný řemeslník',
    'Praha a okolí',
    'Čistá práce a dodržení termínů',
  ],
  ctaLabel = 'Více o mně',
  ctaHref = '/o-me',
  imageSrc = localAboutImage ?? PLACEHOLDER,
  imageAlt = 'Ondra Taclík, elektrikář',
} = Astro.props;
---

<section class="py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">

    <!-- Image -->
    <div class:list={['overflow-hidden rounded-lg shadow-lg', reveal && 'reveal reveal-from-left']}>
      <Image
        src={imageSrc}
        alt={imageAlt}
        width={700}
        height={525}
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    </div>

    <!-- Content -->
    <div class:list={['space-y-5', reveal && 'reveal reveal-delay-2']}>
      <span class="text-topper font-bold uppercase tracking-widest text-orange-500">{topper}</span>
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{heading}</h2>

      {body.map((paragraph) => (
        <p class="text-text-muted leading-relaxed">{paragraph}</p>
      ))}

      <!-- Benefits list -->
      <ul class="space-y-3 pt-2" role="list">
        {benefits.map((benefit) => (
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 size-5 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-text">{benefit}</span>
          </li>
        ))}
      </ul>

      <div class="pt-2">
        <a
          href={ctaHref}
          class="button-outline button-lift inline-flex min-h-[44px] items-center gap-2 rounded-md px-6 py-3 text-base font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
