---
import { services as defaultServices, type Service } from '../data/services';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  topper?: string;
  heading?: string;
  services?: Service[];
  reveal?: boolean;
}

const {
  reveal = false,
  topper = 'Co pro vás mohu udělat',
  heading = 'Mé služby',
  services = defaultServices.slice(0, 6),
} = Astro.props;
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class:list={['mx-auto mb-10 max-w-2xl text-center lg:mb-14', reveal && 'reveal']}>
      <span class="text-topper font-bold uppercase tracking-widest text-accent">{topper}</span>
      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">{heading}</h2>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {services.map((service, i) => (
        <li
          class:list={[
            reveal && 'reveal',
            reveal && `reveal-delay-${(i % 4) + 1}`,
          ]}
        >
          <a
            href={service.href || '/sluzby'}
            aria-label={`Více o službě ${service.title}`}
            class="group flex h-full cursor-pointer flex-col items-center justify-start text-center rounded-lg border border-border bg-background p-6 shadow-sm motion-safe:transform-gpu card-lift"
          >
            <ServiceIcon icon={service.icon} logo={service.logo} />
            <h3 class="font-heading text-h3 font-semibold text-text">{service.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{service.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary transition-colors group-hover:text-accent">
              Zjistit více
              <span class="sr-only"> o službě {service.title}</span>
              <svg class="size-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-8 flex justify-center">
      <a
        href="/sluzby"
        class="button-outline button-lift inline-flex min-h-[44px] items-center justify-center rounded-md px-6 py-3 text-base font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        Zobrazit všechny služby
      </a>
    </div>
  </div>
</section>
