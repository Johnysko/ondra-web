---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { heroImage } from '../config/images';
---

<BaseLayout title="O mě" description={`Poznejte Ondru Taclíka — elektrikáře v Praze a okolí s vášní pro kvalitní práci.`}>
  <Header slot="header" />

  <Banner title="O mě" />

  <!-- Story -->
  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="reveal reveal-from-left aspect-4/3 overflow-hidden rounded-lg shadow-lg">
        <Image
          src={heroImage}
          alt="Ondra Taclík, elektrikář"
          width={1600}
          height={1200}
          loading="lazy"
          class="size-full object-cover object-top"
        />
      </div>
      <div class="reveal reveal-delay-2 space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-orange-500">Můj příběh</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Elektrikář s vášní pro kvalitu</h2>
        <p class="text-text-muted leading-relaxed">
          Jsem Ondra, elektrikář s více než 10 lety zkušeností. Mezi roky jsem si vybudoval reputaci spolehlivého partnera pro domácnosti a firmy v Praze a okolí. Mou práci řídí jednoduché principy: preciznost, transparentnost a vždycky osobní přístup.
        </p>
        <p class="text-text-muted leading-relaxed">
          Jsem licencovaný, pojištěný a věřím tomu, že každá práce — ať už drobná oprava nebo celá elektroinstalace — si zaslouží výši služeb. K vašemu majetku přistupuji s péčí a profesionalitou, kterou si zasloužíte.
        </p>
      </div>
    </div>
  </section>

  <CTA reveal />

  <Footer slot="footer" />
</BaseLayout>
