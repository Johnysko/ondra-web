---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { brand } from '../../config/brand';
---

<BaseLayout title="Zpráva odeslána" description="Vaše zpráva byla přijata.">
  <Header slot="header" />

  <section class="flex min-h-[60vh] items-center justify-center px-4">
    <div class="reveal mx-auto max-w-md text-center">
      <div class="mx-auto mb-6 flex size-16 items-center justify-center rounded-full bg-green-100">
        <svg class="size-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h1 class="font-heading text-h1 font-bold uppercase text-text">
        Zpráva přijata
      </h1>
      <p class="mt-4 text-text-muted leading-relaxed">
        Děkuji za zprávu. Ozvu se vám co nejrychleji to půjde.
      </p>
      <a
        href="/"
        class="button-outline button-lift mt-8 inline-flex min-h-[44px] items-center justify-center rounded-md px-6 py-3 text-base font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        Zpět na úvod
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
