---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { client } from '../data/client';
import { recenzeReviews as reviews } from '../data/reviews';
---

<BaseLayout
  title="Recenze"
  description={`Přečtěte si recenze a reference zákazníků ${brand.name}. Zjistěte, proč nám majitelé domů důvěřují.`}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: client.name,
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '5',
      reviewCount: String(reviews.length),
      bestRating: '5',
    },
  }}
>
  <Header slot="header" />

  <Banner title="Recenze zákazníků" />

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="reveal mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Co o mě říkají zákazníci</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Nejlepší důkaz mé práce jsou slova spokojených zákazníků. Podívejte se, co si o mě myslí ti, kterým jsem pomohl.
        </p>
      </div>

      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
        {reviews.map(({ quote, name, location, rating = 5 }, i) => (
          <li
            class:list={[
              'reveal',
              `reveal-delay-${(i % 4) + 1}`,
            ]}
          >
            <div class="group flex h-full flex-col items-center text-center rounded-lg border border-border bg-background p-6 shadow-sm motion-safe:transform-gpu card-lift">
            <div class="mb-4 flex justify-center gap-0.5" aria-label={`Hodnocení ${rating} z 5 hvězdiček`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  class:list={['size-5', i < rating ? 'text-star' : 'text-border']}
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="flex-1 text-text-muted leading-relaxed">
              &ldquo;{quote}&rdquo;
            </blockquote>
            <div class="mt-4 w-full border-t border-border pt-4">
              <p class="font-semibold text-text">{name}</p>
              {location && <p class="text-sm text-text-muted">{location}</p>}
            </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTA reveal />

  <Footer slot="footer" />
</BaseLayout>
