---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { services } from '../data/services';
import { renderLucideIcon } from '../utils/lucide';
---

<BaseLayout title="Služby" description={`Prohlédněte si kompletní nabídku elektro služeb od ${brand.name}. Elektroinstalace, osvětlení, zabezpečení, hromosvody i revize.`}>
  <Header slot="header" />

  <Banner title="Mé služby" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="reveal mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Co pro vás mohu udělat</h2>
        <p class="mt-3 text-text-muted leading-relaxed">Nabízím komplexní elektropráce — od návrhu a realizace po údržbu a revize. Zajistím bezpečné a moderní řešení osvětlení, zabezpečení a inteligentních systémů pro váš dům nebo provoz, s důrazem na kvalitu a dodržení předpisů.</p>
      </div>

      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {services.map((service, i) => (
          <li
            class:list={[
              'reveal',
              `reveal-delay-${(i % 4) + 1}`,
            ]}
          >
            <div class="group flex h-full cursor-default flex-col items-center text-center rounded-lg border border-border bg-background p-6 shadow-sm motion-safe:transform-gpu card-lift">
              <div class="icon-chip mb-4 flex size-12 items-center justify-center rounded-lg">
                <Fragment set:html={renderLucideIcon(service.icon, 'size-6 transition-transform group-hover:scale-110')} />
              </div>
              <h3 class="font-heading text-h3 font-semibold text-text">{service.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{service.description}</p>
              
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTA reveal />

  <Footer slot="footer" />
</BaseLayout>
